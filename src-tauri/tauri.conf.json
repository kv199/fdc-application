{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FDC",
  "identifier": "FDC",
  "build": {
    "frontendDist": "../overlay"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FDC · HUD",
        "width": 1280,
        "height": 192,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "FDC · HUD",
        "url": "settings.html",
        "width": 820,
        "height": 620,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "focus": true,
        "focusable": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    }
  }
}
